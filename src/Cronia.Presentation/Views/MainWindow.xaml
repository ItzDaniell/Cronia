<Window x:Class="Cronia.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:Cronia.Presentation.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="600" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#121212">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Border Grid.Row="0" Background="#1E1E1E" Padding="20,16" BorderBrush="#2D2D2D" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="CRONIA" FontWeight="Bold" FontSize="18" Foreground="#4F80FF" VerticalAlignment="Center"/>
                <TextBlock Text=" | Personal Productivity Planner" FontSize="14" Foreground="#888888" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Body Content -->
        <Grid Grid.Row="1" Margin="24">
            <Border Background="#1E1E1E" CornerRadius="8" Padding="24" BorderBrush="#2D2D2D" BorderThickness="1">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Estructura Base Inicial Operativa" 
                               FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding StatusMessage}" 
                               FontSize="14" Foreground="#AAAAAA" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <Button Content="Verificar Estado" 
                            Command="{Binding UpdateStatusCommand}"
                            Padding="16,8" Background="#4F80FF" Foreground="White" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer Bar -->
        <Border Grid.Row="2" Background="#181818" Padding="16,8" BorderBrush="#2D2D2D" BorderThickness="0,1,0,0">
            <TextBlock Text=".NET 10 LTS | WPF | SQLite | Clean Architecture | Serilog" 
                       FontSize="11" Foreground="#666666" HorizontalAlignment="Right"/>
        </Border>
    </Grid>
</Window>
